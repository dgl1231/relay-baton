{
  "name": "@relay-baton/cli",
  "version": "1.6.1",
  "description": "Token-aware handoff harness that lets Codex CLI and Claude Code take turns on the same repo",
  "license": "MIT",
  "author": "DongGeon Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgl1231/relay-baton.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dgl1231/relay-baton#readme",
  "bugs": {
    "url": "https://github.com/dgl1231/relay-baton/issues"
  },
  "keywords": [
    "codex",
    "claude",
    "handoff",
    "cli",
    "token-diet",
    "ai-agents"
  ],
  "main": "dist/index.js",
  "bin": {
    "relay-baton": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@relay-baton/core": "workspace:*",
    "@relay-baton/shared": "workspace:*",
    "@relay-baton/tui": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.10"
  }
}
