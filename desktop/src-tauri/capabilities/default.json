{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the window to invoke the bundled relay-baton CLI sidecar: short read-only commands via execute, confirmation-first agent runs via spawn (streaming) + kill (cancel).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "window-state:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/relay-baton",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/relay-baton",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill"
  ]
}
